# Backend port + CORS allowlist (the widget's host origins)
PORT=8787
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173

# Abuse protection (PLAN.md §3.2.1)
RATE_LIMIT_PER_IP_PER_MIN=30
BUDGET_CAP_DAILY_USD=5

# History windowing sent to the provider (newest kept)
MAX_HISTORY_MESSAGES=40

# Provider: openai-compatible (OpenAI, OpenRouter, Groq, …) or offline "fake"
PROVIDER=openai-compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-...
LLM_MODEL=openai/gpt-4o-mini
# Blended $/million tokens — used for the daily budget cap
LLM_PRICE_PER_MTOK=0.2
# Native tool calling: auto (try, fall back to text fences), on, or off
LLM_TOOLS=auto
# LLM traffic log (jsonl — one line per request/response payload; tail -f)
LLM_LOG_PATH=./logs/llm.jsonl
LLM_LOG_ENABLED=true

# Agent content
SYSTEM_PROMPT_PATH=./config/system-prompt.md
SOURCE_OF_TRUTH_PATH=./knowledge/source.md
GREETING_TEXT=Hi! I'm the site assistant — ask me anything.
